APP_NAME=FactuLite
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_PORT=9040
APP_URL_BASE=factlite.tudominio.com
APP_URL=https://factlite.tudominio.com
FORCE_HTTPS=true

DB_CONNECTION=system
DB_HOST=tu-host-mysql-externo
DB_PORT=3306
